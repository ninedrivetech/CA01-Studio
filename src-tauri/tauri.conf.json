{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知了1号",
  "version": "1.0.0",
  "identifier": "com.zhiliao.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "知了1号 · CICADA-1",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": false }
}
