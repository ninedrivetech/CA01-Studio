{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知了1号",
  "version": "1.0.0",
  "identifier": "com.zhiliao.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "知了1号 · CICADA-1",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "上海玖驱科技有限公司",
    "homepage": "https://github.com/ninedrivetech/CA01-Studio",
    "category": "Utility",
    "shortDescription": "CICADA-1 serial speech workbench",
    "longDescription": "An offline serial workbench for the CICADA-1 speech synthesis module, with text encoding, voice configuration and communication logs.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
